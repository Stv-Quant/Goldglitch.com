{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "easygoldglitch-next",
  "main": "worker.ts",
  "compatibility_date": "2026-02-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "EGG_DB",
      "database_name": "easygoldglitch-db",
      "database_id": "9fdab209-da16-4d01-bd46-79b2fbf69df1",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_URL": "https://easygoldglitch.com",
    "MAIL_FROM": "Goldglitch <hola@easygoldglitch.com>"
  },
  // Daily 14:00 UTC = 9:00 a. m. Colombia: renewal reminders + token cleanup (worker.ts → /api/cron/reminders).
  "triggers": { "crons": ["0 14 * * *"] }
  // Secrets (dashboard or `wrangler secret put …`): RESEND_API_KEY, WOMPI_PUBLIC_KEY,
  // WOMPI_INTEGRITY_SECRET, WOMPI_EVENTS_SECRET. The SQPC ingest key lives in D1 (Admin → Datos).
}
